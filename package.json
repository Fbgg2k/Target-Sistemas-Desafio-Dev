{
  "name": "target-sistemas-desafio-dev",
  "version": "1.0.0",
  "private": true,
  "description": "CLI para comissoes, movimentacao de estoque e calculo de juros.",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
